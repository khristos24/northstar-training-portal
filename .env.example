# Copy to .env and supply the four blank private values, or run npm run lab:init.
# This published finance credential is fictional and for isolated training only.
# Never commit .env.
FINANCE_SEED_PASSWORD=Summer2026
EMPLOYEE_SEED_PASSWORD=
ADMIN_SEED_PASSWORD=
SESSION_SECRET=
POSTGRES_PASSWORD=
LAB_MODE=vulnerable
APP_ORIGIN=http://localhost:8080
PORT=8080
BIND_HOST=127.0.0.1
# Docker publishes localhost by default. For a PRIVATE training subnet only:
HOST_BIND_IP=127.0.0.1
HTTPS_ENABLED=false
TRUST_PROXY=false
TRUSTED_PROXY_IPS=
MAX_UPLOAD_BYTES=1048576
SESSION_HOURS=8
# Local Node development only; Docker overrides these:
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
UPLOAD_DIR=./uploads
LOG_DIR=./logs
